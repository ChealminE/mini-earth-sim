# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python (Critical_Earth_simulator/server.py)
__pycache__/
*.pyc
Critical_Earth_simulator/data_log.csv
# 실험 한 번마다 서버가 남기는 기록 (logs/실험_날짜_시각.jsonl·.csv) - data_log.csv처럼 각자 PC에만 둔다
Critical_Earth_simulator/logs/
Critical_Earth_simulator/.venv/

# PyInstaller build output (재빌드 가능한 산출물, 배포는 GitHub Releases로)
Critical_Earth_simulator/build/
Critical_Earth_simulator/dist/

# python venv
venv/
Critical_Earth_simulator/venv/
